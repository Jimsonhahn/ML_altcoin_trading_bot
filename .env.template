# =============================================================================
# ALTCOIN TRADING BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control!

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
NODE_ENV=production                    # development, staging, production
TRADING_MODE=paper                     # paper, live, backtest
LOG_LEVEL=INFO                        # DEBUG, INFO, WARNING, ERROR, CRITICAL
TZ=UTC                                # Timezone

# =============================================================================
# API KEYS & SECRETS
# =============================================================================
# Binance API (Get from: https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true                  # true for testnet, false for mainnet

# Telegram Bot (Get from: @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# JWT Secret for API authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trader
DB_PASSWORD=your_secure_database_password_here

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
# Initial capital in USD
INITIAL_CAPITAL=300000

# Risk management
MAX_PORTFOLIO_RISK=0.20               # Maximum 20% portfolio risk
MAX_POSITION_SIZE=0.10                # Maximum 10% per position
STOP_LOSS_PERCENTAGE=0.05             # 5% stop loss
TAKE_PROFIT_PERCENTAGE=0.15           # 15% take profit

# Strategy settings
DEFAULT_STRATEGY_PROFILE=balanced     # conservative, balanced, aggressive
REBALANCE_FREQUENCY_HOURS=6           # Rebalance every 6 hours
MIN_TRADE_AMOUNT=50                   # Minimum $50 per trade

# =============================================================================
# EXTERNAL API SETTINGS
# =============================================================================
# CoinGecko API (Optional - for additional market data)
COINGECKO_API_KEY=your_coingecko_api_key_here

# Alpha Vantage API (Optional - for traditional market data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# =============================================================================
# MONITORING & ALERTING
# =============================================================================
# Enable/disable various notification types
ENABLE_TRADE_NOTIFICATIONS=true
ENABLE_ERROR_NOTIFICATIONS=true
ENABLE_PERFORMANCE_REPORTS=true
ENABLE_DAILY_SUMMARY=true

# Alert thresholds
ALERT_ON_DRAWDOWN_PERCENT=0.10        # Alert if portfolio drops 10%
ALERT_ON_PROFIT_PERCENT=0.05          # Alert if daily profit exceeds 5%

# =============================================================================
# PERFORMANCE & OPTIMIZATION
# =============================================================================
# Enable ML features (requires additional setup)
ENABLE_ML_PREDICTIONS=true
ML_MODEL_RETRAIN_HOURS=72             # Retrain ML models every 72 hours

# Enable advanced strategies
ENABLE_ARBITRAGE=true
ENABLE_GRID_TRADING=true
ENABLE_DEFI_STRATEGIES=false          # Requires additional DeFi setup

# Cache settings
CACHE_MARKET_DATA_SECONDS=30          # Cache market data for 30 seconds
CACHE_ANALYSIS_RESULTS_SECONDS=300    # Cache analysis for 5 minutes

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# API rate limiting
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST=10

# SSL/TLS settings for production
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

# Session security
SESSION_TIMEOUT_HOURS=24
MAX_LOGIN_ATTEMPTS=5

# =============================================================================
# DEVELOPMENT SETTINGS (only for development environment)
# =============================================================================
# Flask development server
FLASK_ENV=development
FLASK_DEBUG=1

# Debug settings
ENABLE_DEBUG_LOGGING=false
SAVE_DEBUG_DATA=false

# Testing
USE_MOCK_EXCHANGE=false               # Use mock exchange for testing
MOCK_INITIAL_BALANCE=100000          # Mock balance in USD

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
# Database backup settings
ENABLE_AUTO_BACKUP=true
BACKUP_FREQUENCY_HOURS=24             # Backup every 24 hours
BACKUP_RETENTION_DAYS=30              # Keep backups for 30 days
BACKUP_LOCATION=/path/to/backups

# =============================================================================
# ADVANCED SETTINGS (modify only if you know what you're doing)
# =============================================================================
# Exchange settings
EXCHANGE_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

# Memory and performance
MAX_MEMORY_USAGE_MB=2048              # Maximum memory usage
MAX_CPU_USAGE_PERCENT=80              # Maximum CPU usage

# Logging
LOG_ROTATION_SIZE_MB=100              # Rotate logs at 100MB
LOG_RETENTION_DAYS=30                 # Keep logs for 30 days


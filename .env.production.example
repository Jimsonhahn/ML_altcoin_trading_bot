# JANICS FREEDOM FACTORY - PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env.production and fill in your values

# Server Configuration
SERVER_HOST=your-server.com
SERVER_USER=ubuntu
SERVER_PORT=22
DEPLOY_PATH=/home/ubuntu/altcoin_trading_bot

# API Configuration
API_PORT=8080
FLASK_ENV=production
FLASK_DEBUG=False

# Security (CHANGE THESE!)
SECRET_KEY=your-very-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this

# Database
DATABASE_URL=sqlite:///./db/trading_bot.db
# For PostgreSQL: postgresql://user:password@localhost/trading_bot

# Trading Configuration
TRADING_MODE=paper  # Change to 'live' when ready
EXCHANGE_NAME=binance

# Exchange API Keys (for live trading)
EXCHANGE_API_KEY=your-exchange-api-key
EXCHANGE_API_SECRET=your-exchange-api-secret

# Risk Management
MAX_CONCURRENT_TRADES=10
RISK_PERCENTAGE=2.0
STOP_LOSS_PERCENTAGE=3.0

# Monitoring
ENABLE_MONITORING=true
MONITORING_INTERVAL=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/trading_bot.log

# CORS (your frontend domain)
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:3000

# Redis (optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# PostgreSQL (optional)
DB_USER=janics
DB_PASSWORD=your-db-password

# Grafana (optional)
GRAFANA_PASSWORD=your-grafana-password

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=alerts@your-domain.com
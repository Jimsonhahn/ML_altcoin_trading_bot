{
  "capital_allocation": {
    "enabled": true,
    "initial_capital": 10000.0,
    "min_allocation": 100.0,
    "max_allocation_pct": 0.50,
    "rebalance_threshold": 0.05,
    "emergency_stop_threshold": 0.20,
    "update_interval": 60.0,
    "performance_window_days": 30,
    
    "allocation_rules": {
      "max_strategies": 8,
      "min_strategy_allocation": 100,
      "concentration_limit": 0.8,
      "diversification_requirement": 0.1
    },
    
    "risk_management": {
      "max_single_strategy_loss": 0.15,
      "portfolio_stop_loss": 0.25,
      "utilization_warning_threshold": 0.3,
      "over_allocation_warning": 1.05,
      "correlation_risk_limit": 0.7
    },
    
    "performance_tracking": {
      "benchmark_strategy": "buy_and_hold",
      "attribution_period_days": 90,
      "sharpe_calculation_window": 252,
      "var_confidence_level": 0.95,
      "performance_snapshot_interval": 3600
    },
    
    "rebalancing": {
      "auto_rebalance": true,
      "rebalance_frequency_hours": 6,
      "drift_tolerance": 0.05,
      "minimum_rebalance_amount": 50,
      "cost_threshold": 0.001,
      "market_hours_only": false
    },
    
    "reporting": {
      "daily_summary": true,
      "weekly_attribution": true,
      "monthly_detailed_report": true,
      "export_format": "json",
      "include_performance_charts": false,
      "alert_on_allocation_events": true
    },
    
    "emergency_procedures": {
      "auto_stop_on_limit_breach": true,
      "emergency_liquidation_threshold": 0.30,
      "manual_override_required": false,
      "notification_channels": ["email", "webhook"],
      "recovery_procedures": {
        "pause_new_allocations": true,
        "reduce_existing_allocations": 0.5,
        "switch_to_conservative_strategies": true
      }
    }
  }
}
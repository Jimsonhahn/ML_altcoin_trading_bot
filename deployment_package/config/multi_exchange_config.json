{
  "multi_exchange": {
    "enabled": true,
    "primary_exchange": "binance",
    "enabled_exchanges": ["binance", "kucoin", "bybit"],
    "failover_enabled": true,
    "health_check_interval_seconds": 60,
    "max_retry_attempts": 3,
    "retry_delay_seconds": 5
  },
  "exchanges": {
    "binance": {
      "enabled": true,
      "priority": 1,
      "api_key": "${BINANCE_API_KEY}",
      "api_secret": "${BINANCE_API_SECRET}",
      "testnet": false,
      "rate_limits": {
        "requests_per_minute": 1200,
        "orders_per_second": 10,
        "orders_per_day": 200000
      },
      "trading_fees": {
        "maker": 0.001,
        "taker": 0.001
      },
      "min_order_sizes": {
        "BTC/USDT": 0.00001,
        "ETH/USDT": 0.0001,
        "SOL/USDT": 0.01,
        "ADA/USDT": 1.0,
        "DOGE/USDT": 1.0,
        "MATIC/USDT": 1.0
      },
      "max_order_sizes": {
        "BTC/USDT": 9000,
        "ETH/USDT": 100000,
        "SOL/USDT": 1000000,
        "ADA/USDT": 10000000,
        "DOGE/USDT": 10000000,
        "MATIC/USDT": 10000000
      },
      "supported_symbols": [
        "BTC/USDT", "ETH/USDT", "SOL/USDT", "ADA/USDT", 
        "DOGE/USDT", "MATIC/USDT", "DOT/USDT", "LINK/USDT",
        "AVAX/USDT", "UNI/USDT", "ATOM/USDT", "LTC/USDT"
      ],
      "preferred_strategies": ["momentum", "mean_reversion", "scalping"],
      "latency_tolerance_ms": 200,
      "connection_timeout_seconds": 30
    },
    "kucoin": {
      "enabled": true,
      "priority": 2,
      "api_key": "${KUCOIN_API_KEY}",
      "api_secret": "${KUCOIN_API_SECRET}",
      "passphrase": "${KUCOIN_PASSPHRASE}",
      "testnet": false,
      "rate_limits": {
        "requests_per_minute": 1800,
        "orders_per_second": 45,
        "orders_per_day": 200000
      },
      "trading_fees": {
        "maker": 0.001,
        "taker": 0.001
      },
      "min_order_sizes": {
        "BTC/USDT": 0.00001,
        "ETH/USDT": 0.0001,
        "SOL/USDT": 0.01,
        "ADA/USDT": 1.0,
        "DOGE/USDT": 1.0,
        "MATIC/USDT": 1.0
      },
      "max_order_sizes": {
        "BTC/USDT": 10000,
        "ETH/USDT": 100000,
        "SOL/USDT": 1000000,
        "ADA/USDT": 10000000,
        "DOGE/USDT": 10000000,
        "MATIC/USDT": 10000000
      },
      "supported_symbols": [
        "BTC/USDT", "ETH/USDT", "SOL/USDT", "ADA/USDT",
        "DOGE/USDT", "MATIC/USDT", "DOT/USDT", "LINK/USDT",
        "AVAX/USDT", "UNI/USDT", "ATOM/USDT", "LTC/USDT"
      ],
      "preferred_strategies": ["arbitrage", "swing_trading"],
      "latency_tolerance_ms": 300,
      "connection_timeout_seconds": 30
    },
    "bybit": {
      "enabled": true,
      "priority": 3,
      "api_key": "${BYBIT_API_KEY}",
      "api_secret": "${BYBIT_API_SECRET}",
      "testnet": false,
      "rate_limits": {
        "requests_per_minute": 600,
        "orders_per_second": 20,
        "orders_per_day": 200000
      },
      "trading_fees": {
        "maker": 0.001,
        "taker": 0.001
      },
      "min_order_sizes": {
        "BTC/USDT": 0.00001,
        "ETH/USDT": 0.0001,
        "SOL/USDT": 0.01,
        "ADA/USDT": 1.0,
        "DOGE/USDT": 1.0,
        "MATIC/USDT": 1.0
      },
      "max_order_sizes": {
        "BTC/USDT": 10000,
        "ETH/USDT": 100000,
        "SOL/USDT": 1000000,
        "ADA/USDT": 10000000,
        "DOGE/USDT": 10000000,
        "MATIC/USDT": 10000000
      },
      "supported_symbols": [
        "BTC/USDT", "ETH/USDT", "SOL/USDT", "ADA/USDT",
        "DOGE/USDT", "MATIC/USDT", "DOT/USDT", "LINK/USDT"
      ],
      "preferred_strategies": ["momentum", "breakout"],
      "latency_tolerance_ms": 250,
      "connection_timeout_seconds": 30
    }
  },
  "arbitrage": {
    "enabled": true,
    "min_profit_percent": 0.5,
    "min_profit_usd": 10,
    "max_position_size": 1000,
    "opportunity_timeout_seconds": 30,
    "check_interval_seconds": 5,
    "max_concurrent_executions": 2,
    "symbols": [
      "BTC/USDT", "ETH/USDT", "SOL/USDT", "ADA/USDT", "DOGE/USDT", "MATIC/USDT"
    ],
    "excluded_pairs": [
      ["binance", "kucoin"]
    ],
    "slippage_tolerance_percent": 2.0,
    "execution_timeout_seconds": 15
  },
  "smart_routing": {
    "enabled": true,
    "factors": {
      "price_weight": 0.4,
      "liquidity_weight": 0.3,
      "latency_weight": 0.2,
      "fee_weight": 0.1
    },
    "latency_cache_duration_minutes": 5,
    "min_liquidity_threshold": 10000,
    "max_latency_ms": 1000
  },
  "failover": {
    "enabled": true,
    "health_check_symbols": ["BTC/USDT", "ETH/USDT"],
    "max_consecutive_failures": 3,
    "failure_timeout_minutes": 5,
    "auto_reconnect": true,
    "reconnect_delay_seconds": 30,
    "fallback_order": ["binance", "kucoin", "bybit"]
  },
  "balance_management": {
    "auto_rebalance": false,
    "rebalance_threshold_percent": 10,
    "min_balance_per_exchange": {
      "USDT": 100,
      "BTC": 0.001,
      "ETH": 0.01
    },
    "emergency_consolidation": {
      "enabled": true,
      "trigger_conditions": {
        "exchange_offline": true,
        "balance_too_low": true
      },
      "consolidate_to": "binance"
    }
  },
  "monitoring": {
    "enabled": true,
    "metrics": {
      "latency": true,
      "success_rate": true,
      "volume": true,
      "fees": true,
      "arbitrage_opportunities": true
    },
    "alerts": {
      "exchange_offline": true,
      "high_latency": true,
      "failed_orders": true,
      "arbitrage_executed": true,
      "balance_low": true
    },
    "performance_thresholds": {
      "max_latency_ms": 500,
      "min_success_rate_percent": 95,
      "max_failed_orders_per_hour": 10
    }
  },
  "risk_management": {
    "max_exposure_per_exchange_percent": 50,
    "max_daily_trades_per_exchange": 1000,
    "position_size_limits": {
      "single_trade_max_percent": 10,
      "total_exposure_max_percent": 80
    },
    "circuit_breakers": {
      "max_losses_per_hour": 500,
      "max_consecutive_failures": 10,
      "cooldown_period_minutes": 30
    }
  },
  "strategy_routing": {
    "momentum": {
      "preferred_exchanges": ["binance", "bybit"],
      "fallback_exchanges": ["kucoin"],
      "execution_priority": "speed"
    },
    "arbitrage": {
      "preferred_exchanges": ["binance", "kucoin", "bybit"],
      "fallback_exchanges": [],
      "execution_priority": "price"
    },
    "scalping": {
      "preferred_exchanges": ["binance"],
      "fallback_exchanges": ["bybit"],
      "execution_priority": "speed"
    },
    "swing_trading": {
      "preferred_exchanges": ["kucoin", "bybit"],
      "fallback_exchanges": ["binance"],
      "execution_priority": "liquidity"
    }
  },
  "testing": {
    "paper_trading": {
      "enabled": false,
      "initial_balance": 10000,
      "simulate_latency": true,
      "simulate_slippage": true,
      "slippage_range_percent": [0.1, 0.5]
    },
    "stress_testing": {
      "enabled": false,
      "scenarios": [
        "exchange_offline",
        "high_latency",
        "order_rejection",
        "partial_fills"
      ]
    }
  },
  "logging": {
    "level": "INFO",
    "log_exchange_responses": false,
    "log_order_details": true,
    "log_arbitrage_opportunities": true,
    "log_performance_metrics": true
  },
  "metadata": {
    "version": "1.0",
    "created": "2025-01-19",
    "description": "Multi-exchange trading configuration with arbitrage and smart routing",
    "author": "Advanced Trading System"
  }
}
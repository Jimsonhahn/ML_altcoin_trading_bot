# 🚀 Simple Trading Bot Environment Variables
# Kopiere diese Datei zu .env und fülle deine echten Werte ein

# === Trading API Keys ===
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# === Bot Configuration ===
BOT_NAME=SimpleTradingBot
BOT_VERSION=1.0.0
DEBUG_MODE=true

# === Server Configuration ===
WEB_PORT=5000
API_PORT=8001
SERVER_HOST=0.0.0.0

# === Database ===
DATABASE_PATH=trading_data.db
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6

# === Monitoring ===
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
HEALTH_CHECK_INTERVAL=30

# === Telegram Notifications (Optional) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=false

# === Data Sync ===
SYNC_ENABLED=true
SYNC_PATH=sync_data/
AUTO_SYNC_INTERVAL=300

# === Trading Strategies ===
ENABLE_MOMENTUM=true
ENABLE_ARBITRAGE=true
ENABLE_DEFENSIVE=true

# === Risk Management ===
MAX_POSITION_SIZE=1000
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=5.0

# === Server Deployment (Windows Server) ===
WINDOWS_SERVER_IP=85.215.183.30
FIREWALL_ENABLED=true
SSL_ENABLED=false
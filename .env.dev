# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Development environment settings - safe defaults for local development

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
NODE_ENV=development
TRADING_MODE=paper                     # Always paper trading in development
LOG_LEVEL=DEBUG
TZ=UTC

# =============================================================================
# API KEYS & SECRETS (DEVELOPMENT - Use testnet/demo keys only)
# =============================================================================
# Binance Testnet API
BINANCE_API_KEY=testnet_api_key_here
BINANCE_SECRET_KEY=testnet_secret_key_here
BINANCE_TESTNET=true

# Telegram Bot (Optional for development)
TELEGRAM_BOT_TOKEN=dev_bot_token_here
TELEGRAM_CHAT_ID=dev_chat_id_here

# JWT Secret (Development only)
JWT_SECRET=dev_jwt_secret_key_not_for_production

# =============================================================================
# DATABASE SETTINGS (DEVELOPMENT)
# =============================================================================
DB_HOST=postgres-dev
DB_PORT=5432
DB_NAME=trading_bot_dev
DB_USER=trader_dev
DB_PASSWORD=dev_password

# Redis Cache
REDIS_HOST=redis-dev
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# TRADING CONFIGURATION (DEVELOPMENT)
# =============================================================================
INITIAL_CAPITAL=10000                 # Smaller amount for development
MAX_PORTFOLIO_RISK=0.10               # Lower risk for development
MAX_POSITION_SIZE=0.05                # Smaller positions
STOP_LOSS_PERCENTAGE=0.03
TAKE_PROFIT_PERCENTAGE=0.10

DEFAULT_STRATEGY_PROFILE=conservative  # Conservative for development
REBALANCE_FREQUENCY_HOURS=1           # More frequent for testing
MIN_TRADE_AMOUNT=10                   # Lower minimum for testing

# =============================================================================
# DEVELOPMENT FEATURES
# =============================================================================
FLASK_ENV=development
FLASK_DEBUG=1
ENABLE_DEBUG_LOGGING=true
SAVE_DEBUG_DATA=true
USE_MOCK_EXCHANGE=true                # Use mock exchange in development
MOCK_INITIAL_BALANCE=10000

# =============================================================================
# MONITORING & ALERTING (DEVELOPMENT)
# =============================================================================
ENABLE_TRADE_NOTIFICATIONS=false      # Disable to reduce noise
ENABLE_ERROR_NOTIFICATIONS=true
ENABLE_PERFORMANCE_REPORTS=false
ENABLE_DAILY_SUMMARY=false

ALERT_ON_DRAWDOWN_PERCENT=0.05
ALERT_ON_PROFIT_PERCENT=0.10

# =============================================================================
# PERFORMANCE SETTINGS (DEVELOPMENT)
# =============================================================================
ENABLE_ML_PREDICTIONS=false           # Disable ML in development to speed up
ML_MODEL_RETRAIN_HOURS=168            # Weekly retraining in dev

ENABLE_ARBITRAGE=false                # Simplified strategies for development
ENABLE_GRID_TRADING=true
ENABLE_DEFI_STRATEGIES=false

CACHE_MARKET_DATA_SECONDS=10          # Shorter cache for development
CACHE_ANALYSIS_RESULTS_SECONDS=60

# =============================================================================
# SECURITY SETTINGS (RELAXED FOR DEVELOPMENT)
# =============================================================================
API_RATE_LIMIT_PER_MINUTE=120         # Higher limits for development
API_RATE_LIMIT_BURST=20

SESSION_TIMEOUT_HOURS=168             # Longer sessions for development
MAX_LOGIN_ATTEMPTS=10                 # More lenient for development

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Enable hot reload and development tools
ENABLE_HOT_RELOAD=true
ENABLE_PROFILING=true
ENABLE_SQL_LOGGING=true

# Testing settings
RUN_INTEGRATION_TESTS=false
SKIP_SLOW_TESTS=true

# =============================================================================
# RESOURCE LIMITS (DEVELOPMENT)
# =============================================================================
MAX_MEMORY_USAGE_MB=1024              # Lower memory limit for development
MAX_CPU_USAGE_PERCENT=50              # Lower CPU usage for development

LOG_ROTATION_SIZE_MB=50               # Smaller log files
LOG_RETENTION_DAYS=7                  # Shorter retention for development
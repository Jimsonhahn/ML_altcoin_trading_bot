{
  "trading_pairs": ["BTC/USDT", "ETH/USDT"],

  "arbitrage": {
    "min_profit_threshold": 0.005,
    "max_position_size": 1000,
    "min_position_size": 100,
    "execution_timeout": 10,
    "trading_fee": 0.001,
    "withdrawal_fee": 0.0005,
    "max_opportunities_per_hour": 10,
    "enabled_markets": ["binance", "coinbase", "kraken", "futures"]
  },

  "risk": {
    "position_size": 0.02,
    "max_open_positions": 15,
    "stop_loss": 0.01,
    "take_profit": 0.015,
    "max_daily_loss": 0.03,
    "dynamic_position_sizing": true,
    "min_confidence": 0.95
  },

  "timeframes": {
    "analysis": "5m",
    "check_interval": 30,
    "arbitrage_scan_interval": 10
  },

  "exchange": {
    "name": "binance",
    "testnet": true,
    "api_throttle_rate": 2.0
  },

  "system": {
    "parallel_data_updates": true,
    "parallel_signal_processing": true,
    "max_workers": 4,
    "auto_save_interval": 5
  },

  "logging": {
    "level": "INFO",
    "file_enabled": true,
    "file_path": "logs/arbitrage_bot.log",
    "notify_trades": true,
    "notify_errors": true
  },

  "backtest": {
    "start_date": "2024-06-01",
    "end_date": "2024-12-31",
    "initial_balance": 10000,
    "commission": 0.001
  }
}
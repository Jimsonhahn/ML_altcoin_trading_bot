# =============================================================================
# STAGING ENVIRONMENT CONFIGURATION
# =============================================================================
# Staging environment - production-like settings with safety measures

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
NODE_ENV=staging
TRADING_MODE=paper                     # Paper trading in staging for safety
LOG_LEVEL=INFO
TZ=UTC

# =============================================================================
# API KEYS & SECRETS (STAGING - Use testnet keys)
# =============================================================================
# Binance Testnet API for staging
BINANCE_API_KEY=staging_testnet_api_key_here
BINANCE_SECRET_KEY=staging_testnet_secret_key_here
BINANCE_TESTNET=true                  # Keep testnet for staging safety

# Telegram Bot (Staging notifications)
TELEGRAM_BOT_TOKEN=staging_bot_token_here
TELEGRAM_CHAT_ID=staging_chat_id_here

# JWT Secret (Staging - different from production)
JWT_SECRET=staging_jwt_secret_key_change_in_production

# =============================================================================
# DATABASE SETTINGS (STAGING)
# =============================================================================
DB_HOST=staging-postgres-host
DB_PORT=5432
DB_NAME=trading_bot_staging
DB_USER=trader_staging
DB_PASSWORD=staging_secure_password_here

# Redis Cache
REDIS_HOST=staging-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password_here

# =============================================================================
# TRADING CONFIGURATION (STAGING)
# =============================================================================
INITIAL_CAPITAL=50000                 # Moderate amount for staging tests
MAX_PORTFOLIO_RISK=0.15               # Conservative risk for staging
MAX_POSITION_SIZE=0.08                # Moderate position sizes
STOP_LOSS_PERCENTAGE=0.04
TAKE_PROFIT_PERCENTAGE=0.12

DEFAULT_STRATEGY_PROFILE=balanced     # Balanced profile for staging
REBALANCE_FREQUENCY_HOURS=4           # More frequent rebalancing for testing
MIN_TRADE_AMOUNT=25                   # Moderate minimum trade

# =============================================================================
# EXTERNAL API SETTINGS (STAGING)
# =============================================================================
COINGECKO_API_KEY=staging_coingecko_api_key_here
ALPHA_VANTAGE_API_KEY=staging_alpha_vantage_api_key_here

# =============================================================================
# MONITORING & ALERTING (STAGING)
# =============================================================================
ENABLE_TRADE_NOTIFICATIONS=true       # Enable for staging validation
ENABLE_ERROR_NOTIFICATIONS=true
ENABLE_PERFORMANCE_REPORTS=true
ENABLE_DAILY_SUMMARY=true

ALERT_ON_DRAWDOWN_PERCENT=0.08        # Sensitive alerts for staging
ALERT_ON_PROFIT_PERCENT=0.04

# =============================================================================
# PERFORMANCE & OPTIMIZATION (STAGING)
# =============================================================================
ENABLE_ML_PREDICTIONS=true            # Test ML in staging
ML_MODEL_RETRAIN_HOURS=48             # More frequent retraining for testing

ENABLE_ARBITRAGE=true                 # Test all strategies in staging
ENABLE_GRID_TRADING=true
ENABLE_DEFI_STRATEGIES=true

CACHE_MARKET_DATA_SECONDS=20          # Moderate caching
CACHE_ANALYSIS_RESULTS_SECONDS=180

# =============================================================================
# SECURITY SETTINGS (STAGING - PRODUCTION-LIKE)
# =============================================================================
API_RATE_LIMIT_PER_MINUTE=80          # Moderate rate limiting
API_RATE_LIMIT_BURST=15

SESSION_TIMEOUT_HOURS=12              # Shorter sessions for security testing
MAX_LOGIN_ATTEMPTS=3                  # Stricter for security testing

# SSL/TLS settings (staging certificates)
SSL_CERT_PATH=/staging/ssl/cert.pem
SSL_KEY_PATH=/staging/ssl/private.key

# =============================================================================
# STAGING-SPECIFIC SETTINGS
# =============================================================================
# Enable detailed logging for staging validation
ENABLE_PERFORMANCE_LOGGING=true
ENABLE_TRADE_ANALYSIS_LOGGING=true
ENABLE_STRATEGY_DEBUG_LOGGING=true

# Staging safety measures
ENABLE_STAGING_SAFETY_CHECKS=true
MAX_DAILY_TRADES=100                  # Limit trades in staging
MAX_DAILY_VOLUME=10000               # Limit daily volume in staging

# =============================================================================
# BACKUP & DISASTER RECOVERY (STAGING)
# =============================================================================
ENABLE_AUTO_BACKUP=true
BACKUP_FREQUENCY_HOURS=12             # More frequent backups for testing
BACKUP_RETENTION_DAYS=14              # Shorter retention for staging
BACKUP_LOCATION=/staging/backups

# =============================================================================
# RESOURCE SETTINGS (STAGING)
# =============================================================================
MAX_MEMORY_USAGE_MB=1536              # Moderate memory usage
MAX_CPU_USAGE_PERCENT=70              # Moderate CPU usage

LOG_ROTATION_SIZE_MB=75               # Moderate log file sizes
LOG_RETENTION_DAYS=14                 # Shorter log retention

# =============================================================================
# TESTING & VALIDATION (STAGING)
# =============================================================================
# Enable comprehensive testing in staging
RUN_INTEGRATION_TESTS=true
RUN_PERFORMANCE_TESTS=true
RUN_SECURITY_TESTS=true

# Validation settings
VALIDATE_ALL_TRADES=true
VALIDATE_RISK_LIMITS=true
VALIDATE_API_RESPONSES=true

# Performance monitoring
ENABLE_METRICS_COLLECTION=true
METRICS_RETENTION_DAYS=30
ENABLE_PERFORMANCE_ALERTS=true
# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# PRODUCTION SETTINGS - LIVE TRADING WITH REAL MONEY
# ⚠️  CRITICAL: Review all settings before deploying to production!

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
NODE_ENV=production
TRADING_MODE=live                      # ⚠️  LIVE TRADING - REAL MONEY AT RISK
LOG_LEVEL=INFO                        # INFO level for production (not DEBUG)
TZ=UTC

# =============================================================================
# API KEYS & SECRETS (PRODUCTION - REAL KEYS)
# =============================================================================
# ⚠️  CRITICAL: Use REAL Binance API keys for production
# Get from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=REPLACE_WITH_REAL_BINANCE_API_KEY
BINANCE_SECRET_KEY=REPLACE_WITH_REAL_BINANCE_SECRET_KEY
BINANCE_TESTNET=false                 # ⚠️  FALSE = LIVE TRADING

# Telegram Bot for production alerts
TELEGRAM_BOT_TOKEN=REPLACE_WITH_REAL_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_REAL_TELEGRAM_CHAT_ID

# JWT Secret - MUST be changed for production
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET_FOR_PRODUCTION

# =============================================================================
# DATABASE SETTINGS (PRODUCTION)
# =============================================================================
DB_HOST=production-postgres-host
DB_PORT=5432
DB_NAME=trading_bot_production
DB_USER=trader_prod
DB_PASSWORD=REPLACE_WITH_SECURE_DB_PASSWORD

# Redis Cache (Production)
REDIS_HOST=production-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD

# =============================================================================
# TRADING CONFIGURATION (PRODUCTION - YOUR 300,000€)
# =============================================================================
INITIAL_CAPITAL=300000                # Your actual capital
MAX_PORTFOLIO_RISK=0.20               # Maximum 20% portfolio risk
MAX_POSITION_SIZE=0.10                # Maximum 10% per position
STOP_LOSS_PERCENTAGE=0.05             # 5% stop loss (adjust based on risk tolerance)
TAKE_PROFIT_PERCENTAGE=0.15           # 15% take profit

DEFAULT_STRATEGY_PROFILE=balanced     # balanced recommended for 300k
REBALANCE_FREQUENCY_HOURS=6           # Rebalance every 6 hours
MIN_TRADE_AMOUNT=100                  # Minimum $100 per trade

# =============================================================================
# EXTERNAL API SETTINGS (PRODUCTION)
# =============================================================================
COINGECKO_API_KEY=REPLACE_WITH_REAL_COINGECKO_API_KEY
ALPHA_VANTAGE_API_KEY=REPLACE_WITH_REAL_ALPHA_VANTAGE_API_KEY

# =============================================================================
# MONITORING & ALERTING (PRODUCTION - COMPREHENSIVE)
# =============================================================================
ENABLE_TRADE_NOTIFICATIONS=true       # Get notified of all trades
ENABLE_ERROR_NOTIFICATIONS=true       # Critical for production
ENABLE_PERFORMANCE_REPORTS=true       # Daily performance updates
ENABLE_DAILY_SUMMARY=true            # Daily summary reports

# Production alert thresholds
ALERT_ON_DRAWDOWN_PERCENT=0.10        # Alert if portfolio drops 10%
ALERT_ON_PROFIT_PERCENT=0.05          # Alert if daily profit exceeds 5%
ALERT_ON_LARGE_TRADE=5000             # Alert for trades > $5000
ALERT_ON_API_ERRORS=true              # Alert on API connection issues

# =============================================================================
# PERFORMANCE & OPTIMIZATION (PRODUCTION)
# =============================================================================
ENABLE_ML_PREDICTIONS=true            # Use ML for better performance
ML_MODEL_RETRAIN_HOURS=72             # Retrain every 3 days

# Enable profitable strategies for production
ENABLE_ARBITRAGE=true                 # High Sharpe ratio strategy
ENABLE_GRID_TRADING=true              # Stable returns
ENABLE_DEFI_STRATEGIES=true           # Additional yield opportunities

# Production caching for performance
CACHE_MARKET_DATA_SECONDS=30          # 30-second cache for market data
CACHE_ANALYSIS_RESULTS_SECONDS=300    # 5-minute cache for analysis

# =============================================================================
# SECURITY SETTINGS (PRODUCTION - MAXIMUM SECURITY)
# =============================================================================
# Strict API rate limiting
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST=10

# SSL/TLS certificates (REQUIRED for production)
SSL_CERT_PATH=/production/ssl/cert.pem
SSL_KEY_PATH=/production/ssl/private.key

# Session security
SESSION_TIMEOUT_HOURS=8               # 8-hour sessions for security
MAX_LOGIN_ATTEMPTS=3                  # Strict login limits

# IP whitelisting (recommended for production)
ALLOWED_IPS=your.production.ip.address,another.allowed.ip

# =============================================================================
# BACKUP & DISASTER RECOVERY (PRODUCTION - CRITICAL)
# =============================================================================
ENABLE_AUTO_BACKUP=true               # CRITICAL: Enable backups
BACKUP_FREQUENCY_HOURS=6              # Backup every 6 hours
BACKUP_RETENTION_DAYS=90              # Keep backups for 90 days
BACKUP_LOCATION=/production/backups

# Database replication (recommended)
ENABLE_DB_REPLICATION=true
REPLICA_DB_HOST=production-postgres-replica

# =============================================================================
# PRODUCTION SAFETY MEASURES
# =============================================================================
# Emergency stop mechanisms
ENABLE_EMERGENCY_STOP=true
EMERGENCY_STOP_DRAWDOWN=0.25          # Emergency stop at 25% drawdown
EMERGENCY_STOP_DAILY_LOSS=0.05        # Stop if daily loss exceeds 5%

# Daily trading limits for safety
MAX_DAILY_TRADES=200                  # Maximum trades per day
MAX_DAILY_VOLUME=100000              # Maximum daily volume in USD

# Position size validation
VALIDATE_POSITION_SIZES=true
MAX_SINGLE_TRADE_SIZE=30000           # Maximum $30k per single trade

# =============================================================================
# MONITORING & ALERTING (PRODUCTION)
# =============================================================================
# Health check settings
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10

# Prometheus metrics (for monitoring)
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_PORT=9090

# Log aggregation
ENABLE_LOG_SHIPPING=true
LOG_SHIPPING_ENDPOINT=your-log-aggregation-service

# =============================================================================
# RESOURCE SETTINGS (PRODUCTION)
# =============================================================================
MAX_MEMORY_USAGE_MB=4096              # 4GB memory limit
MAX_CPU_USAGE_PERCENT=80              # 80% CPU limit

# Log management
LOG_ROTATION_SIZE_MB=500              # Rotate logs at 500MB
LOG_RETENTION_DAYS=90                 # Keep logs for 90 days
ENABLE_LOG_COMPRESSION=true

# =============================================================================
# COMPLIANCE & AUDITING (PRODUCTION)
# =============================================================================
# Enable comprehensive auditing
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=365          # Keep audit logs for 1 year

# Trade reporting
ENABLE_TRADE_REPORTING=true
GENERATE_MONTHLY_REPORTS=true
GENERATE_TAX_REPORTS=true

# Compliance checks
ENABLE_COMPLIANCE_CHECKS=true
CHECK_TRADE_LIMITS=true
CHECK_CONCENTRATION_LIMITS=true

# =============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =============================================================================
# Container settings
CONTAINER_RESTART_POLICY=unless-stopped
ENABLE_CONTAINER_HEALTH_CHECKS=true

# Load balancing (if using multiple instances)
ENABLE_LOAD_BALANCING=false
LOAD_BALANCER_PORT=8080

# Service discovery
ENABLE_SERVICE_DISCOVERY=false
SERVICE_REGISTRY_URL=your-service-registry

# =============================================================================
# NOTIFICATION ESCALATION (PRODUCTION)
# =============================================================================
# Multiple notification channels for production
TELEGRAM_CHAT_ID_ERRORS=CRITICAL_ERRORS_CHAT_ID
TELEGRAM_CHAT_ID_TRADES=TRADES_CHAT_ID
TELEGRAM_CHAT_ID_REPORTS=REPORTS_CHAT_ID

# Email notifications for critical events
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_SERVER=your-smtp-server
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
ALERT_EMAIL_RECIPIENTS=your-email@example.com,backup-email@example.com

# =============================================================================
# PERFORMANCE TARGETS (PRODUCTION)
# =============================================================================
# Expected performance metrics for monitoring
TARGET_ANNUAL_RETURN=0.60             # 60% annual return target
TARGET_SHARPE_RATIO=1.80              # 1.8 Sharpe ratio target
MAX_ACCEPTABLE_DRAWDOWN=0.20          # 20% maximum drawdown
MIN_WIN_RATE=0.55                     # 55% minimum win rate

# Performance monitoring thresholds
ALERT_IF_RETURN_BELOW=0.40            # Alert if annual return drops below 40%
ALERT_IF_SHARPE_BELOW=1.20            # Alert if Sharpe ratio drops below 1.2
ALERT_IF_DRAWDOWN_ABOVE=0.15          # Alert if drawdown exceeds 15%

# =============================================================================
# DISASTER RECOVERY (PRODUCTION)
# =============================================================================
# Failover settings
ENABLE_AUTOMATIC_FAILOVER=true
FAILOVER_TRIGGER_DOWNTIME_MINUTES=5
BACKUP_TRADING_INSTANCE=backup-instance-url

# Data recovery
ENABLE_POINT_IN_TIME_RECOVERY=true
RECOVERY_POINT_OBJECTIVE_HOURS=1      # Maximum 1 hour data loss
RECOVERY_TIME_OBJECTIVE_HOURS=2       # Maximum 2 hours downtime

# =============================================================================
# FINAL PRODUCTION CHECKLIST
# =============================================================================
# ✅ Replace all REPLACE_WITH_* values with actual credentials
# ✅ Set BINANCE_TESTNET=false for live trading
# ✅ Configure SSL certificates
# ✅ Set up monitoring and alerting
# ✅ Test disaster recovery procedures
# ✅ Verify backup systems
# ✅ Review all trading limits and risk parameters
# ✅ Ensure compliance with local regulations
# ✅ Set up multiple notification channels
# ✅ Test emergency stop mechanisms
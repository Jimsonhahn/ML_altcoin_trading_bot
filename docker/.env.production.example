# 🚀 Production Environment Variables für Enhanced Trading Bot
# Kopiere zu .env und fülle echte Werte ein

# ===============================
# DATABASE CONFIGURATION
# ===============================
DB_PASSWORD=your_super_secure_database_password_here
REDIS_PASSWORD=your_redis_password_here

# ===============================
# TRADING API CREDENTIALS
# ===============================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Andere Exchange APIs (optional)
COINBASE_API_KEY=
COINBASE_SECRET_KEY=
KRAKEN_API_KEY=
KRAKEN_SECRET_KEY=

# ===============================
# BOT CONFIGURATION
# ===============================
TRADING_MODE=paper
# Werte: paper, live, backtest

# ===============================
# SECURITY
# ===============================
SECRET_KEY=generate_a_very_secure_secret_key_with_32_characters
JWT_SECRET_KEY=another_secure_jwt_secret_key_here

# ===============================
# SERVER CONFIGURATION
# ===============================
SERVER_NAME=85.215.183.30
# Deine Windows Server IP

CORS_ORIGINS=http://85.215.183.30,https://85.215.183.30,http://localhost:3000
# Comma-separated URLs für CORS

# ===============================
# ENHANCED FEATURES
# ===============================
INTELLIGENCE_ENABLED=true
LEARNING_ENABLED=true
DASHBOARD_UPDATES=true
EXPORT_PATH=/app/intelligence_exports

# ===============================
# MONITORING (optional)
# ===============================
GRAFANA_PASSWORD=secure_grafana_admin_password

# ===============================
# TELEGRAM NOTIFICATIONS (optional)
# ===============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===============================
# ADVANCED SETTINGS
# ===============================
LOG_LEVEL=INFO
MAX_POSITION_SIZE=1000
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=5.0

# Risk Management
MAX_DAILY_LOSS=500
MAX_DRAWDOWN=0.15
RISK_PER_TRADE=0.02

# Performance Tuning
DB_POOL_SIZE=20
REDIS_POOL_SIZE=10
API_RATE_LIMIT=100

# ===============================
# BACKUP CONFIGURATION
# ===============================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
{
  "advanced_monitoring": {
    "enabled": true,
    "metrics_retention_days": 30,
    "health_check_interval": 60,
    "alert_cooldown_minutes": 15,
    "metrics_db_path": "data/monitoring/metrics.db",
    "alerts_db_path": "data/monitoring/alerts.db",
    
    "notification_channels": {
      "email": {
        "enabled": false,
        "smtp_server": "smtp.gmail.com",
        "smtp_port": 587,
        "username": "",
        "password": "",
        "from_email": "tradingbot@yourdomain.com",
        "to_emails": ["admin@yourdomain.com"],
        "use_tls": true
      },
      
      "webhook": {
        "enabled": false,
        "url": "https://your-webhook-url.com/alerts",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer YOUR_TOKEN"
        },
        "timeout": 10
      },
      
      "slack": {
        "enabled": false,
        "webhook_url": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK",
        "channel": "#trading-alerts",
        "username": "TradingBot",
        "emoji": ":robot_face:"
      },
      
      "discord": {
        "enabled": false,
        "webhook_url": "https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK",
        "username": "TradingBot"
      },
      
      "file": {
        "enabled": true,
        "log_file": "logs/alerts.log",
        "max_size_mb": 100
      }
    },
    
    "system_monitoring": {
      "cpu_threshold_percent": 95,
      "memory_threshold_percent": 90,
      "disk_threshold_percent": 90,
      "network_threshold_mbps": 100,
      "process_monitoring": true,
      "collect_interval_seconds": 30
    },
    
    "bot_monitoring": {
      "track_trades": true,
      "track_pnl": true,
      "track_positions": true,
      "track_api_calls": true,
      "track_response_times": true,
      "error_tracking": true,
      "performance_tracking": true
    },
    
    "health_checks": {
      "database_connection": {
        "enabled": true,
        "interval_seconds": 300,
        "timeout_seconds": 10,
        "failure_threshold": 3
      },
      "disk_space": {
        "enabled": true,
        "interval_seconds": 600,
        "timeout_seconds": 5,
        "failure_threshold": 2,
        "free_space_threshold_percent": 10
      },
      "memory_usage": {
        "enabled": true,
        "interval_seconds": 60,
        "timeout_seconds": 5,
        "failure_threshold": 3,
        "usage_threshold_percent": 90
      },
      "cpu_usage": {
        "enabled": true,
        "interval_seconds": 60,
        "timeout_seconds": 5,
        "failure_threshold": 3,
        "usage_threshold_percent": 95
      },
      "api_connectivity": {
        "enabled": true,
        "interval_seconds": 120,
        "timeout_seconds": 15,
        "failure_threshold": 2
      },
      "strategy_health": {
        "enabled": true,
        "interval_seconds": 180,
        "timeout_seconds": 10,
        "failure_threshold": 2
      }
    },
    
    "alerting_rules": {
      "critical_conditions": {
        "emergency_stop_triggered": {
          "channels": ["email", "slack", "console"],
          "escalation_time_minutes": 5
        },
        "risk_limit_breached": {
          "channels": ["email", "slack", "console"],
          "escalation_time_minutes": 15
        },
        "system_health_failure": {
          "channels": ["email", "webhook", "console"],
          "escalation_time_minutes": 30
        }
      },
      
      "error_conditions": {
        "trading_errors": {
          "channels": ["slack", "console"],
          "escalation_time_minutes": 60
        },
        "api_errors": {
          "channels": ["slack", "console"],
          "escalation_time_minutes": 45
        },
        "strategy_failures": {
          "channels": ["slack", "console"],
          "escalation_time_minutes": 30
        }
      },
      
      "warning_conditions": {
        "performance_degradation": {
          "channels": ["console"],
          "escalation_time_minutes": 120
        },
        "resource_usage_high": {
          "channels": ["console"],
          "escalation_time_minutes": 180
        }
      }
    },
    
    "metrics_collection": {
      "custom_metrics": {
        "portfolio_metrics": ["total_value", "pnl", "drawdown", "sharpe_ratio"],
        "trading_metrics": ["trades_per_hour", "win_rate", "profit_factor"],
        "risk_metrics": ["var", "risk_score", "exposure"],
        "system_metrics": ["cpu", "memory", "disk", "network"]
      },
      
      "aggregation_intervals": {
        "raw": "30s",
        "summary": "5m",
        "hourly": "1h",
        "daily": "1d"
      }
    },
    
    "dashboards": {
      "system_dashboard": {
        "enabled": true,
        "refresh_interval_seconds": 30,
        "panels": [
          "system_resources",
          "bot_performance",
          "active_alerts",
          "health_status"
        ]
      },
      
      "trading_dashboard": {
        "enabled": true,
        "refresh_interval_seconds": 60,
        "panels": [
          "portfolio_value",
          "active_positions",
          "pnl_chart",
          "trade_history"
        ]
      }
    },
    
    "reporting": {
      "daily_summary": {
        "enabled": true,
        "delivery_time": "09:00",
        "include_charts": false,
        "recipients": ["admin@yourdomain.com"]
      },
      
      "weekly_report": {
        "enabled": true,
        "delivery_day": "monday",
        "delivery_time": "08:00",
        "include_performance_analysis": true,
        "include_risk_analysis": true
      },
      
      "monthly_report": {
        "enabled": true,
        "delivery_day": 1,
        "delivery_time": "08:00",
        "comprehensive_analysis": true,
        "include_recommendations": true
      }
    },
    
    "integrations": {
      "prometheus": {
        "enabled": false,
        "endpoint": "http://localhost:9090",
        "push_gateway": "http://localhost:9091"
      },
      
      "grafana": {
        "enabled": false,
        "url": "http://localhost:3000",
        "api_key": "",
        "dashboard_ids": []
      },
      
      "elk_stack": {
        "enabled": false,
        "elasticsearch_url": "http://localhost:9200",
        "logstash_host": "localhost:5044",
        "kibana_url": "http://localhost:5601"
      }
    }
  }
}
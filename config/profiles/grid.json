{
  "trading_pairs": ["BTC/USDT"],

  "grid_trading": {
    "price_range": {
      "lower": 35000,
      "upper": 50000,
      "comment": "Adjust based on current market prices"
    },
    "num_grids": 15,
    "investment_per_grid": 300,
    "volatility_multiplier": 2.0,
    "auto_adjust_range": true,
    "min_grid_spacing": 200,
    "max_investment_per_symbol": 5000
  },

  "risk": {
    "position_size": 0.03,
    "max_open_positions": 20,
    "stop_loss": 0.08,
    "take_profit": 0.03,
    "max_daily_loss": 0.05,
    "dynamic_position_sizing": true,
    "min_confidence": 0.85,
    "adjust_to_min_size": true
  },

  "timeframes": {
    "analysis": "15m",
    "check_interval": 120,
    "grid_rebalance_interval": 300,
    "social_check_interval": 7200
  },

  "exchange": {
    "name": "binance",
    "testnet": true,
    "api_throttle_rate": 1.5
  },

  "system": {
    "parallel_data_updates": true,
    "parallel_signal_processing": false,
    "max_workers": 3,
    "auto_save_interval": 15,
    "status_update_interval": 30,
    "max_api_errors": 8,
    "api_error_window": 600
  },

  "data": {
    "source": "exchange",
    "min_candles": 50,
    "use_cache": true
  },

  "logging": {
    "level": "INFO",
    "file_enabled": true,
    "file_path": "logs/grid_trading.log",
    "notify_trades": true,
    "notify_errors": true
  },

  "backtest": {
    "start_date": "2024-06-01",
    "end_date": "2024-12-31",
    "initial_balance": 10000,
    "commission": 0.001,
    "create_plots": true,
    "export_results": true,
    "output_dir": "grid_backtest"
  },

  "technical": {
    "rsi": {
      "period": 14,
      "oversold": 25,
      "overbought": 75
    },
    "ma": {
      "short": 10,
      "long": 30
    },
    "bollinger": {
      "period": 20,
      "std_dev": 2
    }
  },

  "reports": {
    "auto_generate_on_stop": true,
    "default_days": 7,
    "default_format": "html"
  }
}
{
  "name": "defi",
  "description": "DeFi Yield Compounder - Automatisches Zinseszins-System",
  "trading_pairs": ["USDT/USDT", "USDC/USDC", "DAI/DAI", "BUSD/BUSD"],
  "defi": {
    "enabled": true,
    "min_apy": 0.15,
    "compound_frequency": 86400,
    "gas_limit": 0.005,
    "max_protocols": 5,
    "risk_levels": ["low", "medium"],
    "protocol_allocation": {
      "aave": 0.3,
      "compound": 0.2,
      "yearn": 0.2,
      "curve": 0.2,
      "convex": 0.1
    },
    "compound_thresholds": {
      "min_rewards_usd": 10,
      "min_rewards_pct": 0.001
    },
    "rebalance_thresholds": {
      "apy_difference": 0.05,
      "check_interval": 3600
    },
    "safety": {
      "max_single_protocol": 0.4,
      "tvl_minimum": 100000000,
      "audit_required": true,
      "age_minimum_days": 30
    }
  },
  "risk": {
    "position_size": 0.2,
    "max_open_positions": 10,
    "stop_loss": 0.1,
    "emergency_withdraw": 0.2
  },
  "timeframes": {
    "analysis": "1d",
    "check_interval": 3600
  },
  "logging": {
    "level": "INFO",
    "console": true,
    "file": true
  }
}
{
  "name": "ultimate_autopilot",
  "description": "Ultimate AutoPilot v3.0 - Complete Lazy Millionaire Stack with DeFi",
  "version": "3.0",

  "trading_pairs": ["BTC/USDT", "ETH/USDT", "SOL/USDT", "USDT/USDT", "USDC/USDC"],

  "mode": "balanced",
  "rebalance_interval": 3600,

  "capital_allocation": {
    "defi_yield": 0.30,
    "grid_trading": 0.25,
    "arbitrage": 0.20,
    "momentum": 0.10,
    "mean_reversion": 0.05,
    "ml": 0.05,
    "liquidation": 0.05
  },

  "strategy_configs": {
    "defi_yield": {
      "min_apy": 0.15,
      "compound_frequency": 24,
      "protocol_weights": {
        "aave": 0.25,
        "compound": 0.20,
        "yearn": 0.20,
        "curve": 0.20,
        "convex": 0.15
      }
    },

    "grid_trading": {
      "num_grids": 20,
      "investment_per_grid": 300,
      "auto_adjust_range": true
    },

    "arbitrage": {
      "min_profit_threshold": 0.004,
      "max_position_size": 1500,
      "execution_timeout": 10
    }
  },

  "defi": {
    "enabled": true,
    "min_apy": 0.15,
    "compound_frequency": 24,
    "gas_limit": 0.005,
    "max_protocols": 5,
    "risk_levels": ["low", "medium"],

    "protocol_weights": {
      "aave": 0.25,
      "compound": 0.20,
      "yearn": 0.20,
      "curve": 0.20,
      "convex": 0.15
    },

    "compound_settings": {
      "auto_compound": true,
      "compound_threshold": 50,
      "gas_price_limit": 100,
      "optimal_times": ["02:00", "14:00"]
    },

    "risk_management": {
      "max_single_protocol": 0.4,
      "min_tvl": 10000000,
      "require_audit": true,
      "min_protocol_age": 30
    }
  },

  "performance_targets": {
    "daily_return": 0.002,
    "weekly_return": 0.015,
    "monthly_return": 0.065,
    "annual_return": 1.0
  },

  "risk": {
    "position_size": 0.10,
    "max_open_positions": 20,
    "stop_loss": 0.03,
    "take_profit": 0.06,
    "max_drawdown": 0.15,
    "daily_loss_limit": 0.05
  },

  "monitoring": {
    "performance_check_interval": 300,
    "strategy_rotation_enabled": true,
    "auto_optimize": true,
    "alert_on_drawdown": 0.10,
    "report_interval": 3600
  },

  "advanced_features": {
    "cross_strategy_synergy": true,
    "market_regime_detection": true,
    "dynamic_allocation": true,
    "ml_optimization": true,
    "multi_chain_support": true
  },

  "expected_performance": {
    "conservative": {
      "annual_return": "30-50%",
      "max_drawdown": "10%",
      "sharpe_ratio": 1.5
    },
    "balanced": {
      "annual_return": "50-100%",
      "max_drawdown": "15%",
      "sharpe_ratio": 2.0
    },
    "aggressive": {
      "annual_return": "100-200%",
      "max_drawdown": "25%",
      "sharpe_ratio": 1.8
    }
  },

  "backtest": {
    "start_date": "2024-01-01",
    "end_date": "2024-12-31",
    "initial_balance": 10000,
    "commission": 0.001
  },

  "logging": {
    "level": "INFO",
    "file_enabled": true,
    "file_path": "logs/ultimate_autopilot.log",
    "performance_tracking": true,
    "trade_journal": true
  }
}
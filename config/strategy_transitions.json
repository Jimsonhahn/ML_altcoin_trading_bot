{
  "strategy_transitions": {
    "enabled": true,
    "max_concurrent": 3,
    "default_unwind_minutes": 30,
    "emergency_unwind_minutes": 5,
    "risk_pause_threshold": 0.10,
    "transition_rules": {
      "bull_to_bear": {
        "priority": "high",
        "max_duration_minutes": 15,
        "close_losing_positions_first": true
      },
      "bear_to_bull": {
        "priority": "normal", 
        "max_duration_minutes": 45,
        "preserve_profitable_positions": true
      },
      "volatile_to_sideways": {
        "priority": "normal",
        "max_duration_minutes": 30,
        "gradual_unwind": true
      },
      "any_to_extreme_fear": {
        "priority": "emergency",
        "max_duration_minutes": 5,
        "force_immediate": true
      }
    },
    "position_unwinding": {
      "max_slippage": 0.005,
      "max_loss_per_position": 0.02,
      "max_concurrent_closes": 3,
      "importance_factors": {
        "loss_multiplier": 2.0,
        "profit_reduction": 0.7,
        "large_position_threshold": 1000,
        "large_position_multiplier": 1.2
      }
    },
    "risk_constraints": {
      "pause_on_drawdown": 0.10,
      "emergency_stop_drawdown": 0.15,
      "max_transition_loss": 0.05,
      "liquidity_check_enabled": true
    },
    "notifications": {
      "transition_started": true,
      "transition_completed": true,
      "transition_failed": true,
      "emergency_transitions": true,
      "position_close_errors": true
    }
  }
}
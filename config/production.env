# Production Environment Configuration for Server
# Copy this to /opt/trading-bot/.env on your server

# ==========================================
# SERVER CONFIGURATION
# ==========================================
ENVIRONMENT=production
DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Intelligence API Configuration
INTELLIGENCE_API_HOST=0.0.0.0
INTELLIGENCE_API_PORT=8001
INTELLIGENCE_API_CORS_ORIGINS=http://85.215.183.30:3000,http://85.215.183.30:80,http://85.215.183.30:443

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://trading_user:your_secure_password@localhost:5432/trading_bot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trading_user
DB_PASSWORD=your_secure_password

# Redis for caching
REDIS_URL=redis://localhost:6379/0

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_change_this_in_production
JWT_SECRET=your_jwt_secret_here_change_this_too

# API Keys (set these with your actual keys)
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=false

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=/opt/trading-bot/logs/trading_bot.log
ACCESS_LOG_FILE=/opt/trading-bot/logs/access.log
ERROR_LOG_FILE=/opt/trading-bot/logs/error.log

# ==========================================
# TRADING CONFIGURATION
# ==========================================
TRADING_MODE=paper  # Change to 'live' for live trading
INITIAL_CAPITAL=100000.0
MAX_PORTFOLIO_RISK=0.20
MAX_POSITION_SIZE=0.10

# ==========================================
# INTELLIGENCE DASHBOARD CONFIGURATION
# ==========================================
INTELLIGENCE_ENABLED=true
INTELLIGENCE_AUTO_REFRESH=30
INTELLIGENCE_DATA_RETENTION_DAYS=90
INTELLIGENCE_ML_ENABLED=true
INTELLIGENCE_PATTERN_DETECTION=true

# ==========================================
# MONITORING CONFIGURATION
# ==========================================
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=300
METRICS_RETENTION_DAYS=30
EMAIL_ALERTS_ENABLED=false
TELEGRAM_ALERTS_ENABLED=true